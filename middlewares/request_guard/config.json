    "rate_limit": {
        "enabled": false,
        "per_ip_per_minute": 180,
        "ban_minutes": 10
    },
    "identity": {
        "spider": "pass",
        "human_ref": "pass",
        "direct": "pass",
        "unknown": "pass",
        "disguise_template": "request_guard/cloak_default.html"
    },
    "spider_keywords": {
        "baidu": ["baiduspider"],
        "google": ["googlebot"],
        "bing": ["bingbot", "msnbot"],
        "sogou": ["sogou"],
        "360": ["360spider"],
        "bytespider": ["bytespider"],
        "yisou": ["yisouspider"],
        "yandex": ["yandexbot"],
        "petal": ["petalbot"],
        "semrush": ["semrushbot"],
        "ahrefs": ["ahrefsbot"],
        "mj12": ["mj12bot"],
        "duckduckgo": ["duckduckbot"],
        "facebook": ["facebookexternalhit"],
        "twitter": ["twitterbot"],
        "linkedin": ["linkedinbot"],
        "archiver": ["ia_archiver"],
        "generic": ["spider", "bot", "crawler", "crawl", "slurp", "spider"]
